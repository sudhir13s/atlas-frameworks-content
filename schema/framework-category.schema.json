{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theaiatlas.dev/schema/frameworks/framework-category.schema.json",
  "title": "framework-category",
  "allOf": [{ "$ref": "_shared.schema.json#/$defs/base" }],
  "properties": {
    "type": { "const": "framework-category" },
    "label": { "type": "string", "minLength": 1, "description": "category name shown as the section heading" },
    "order": { "type": "integer", "description": "display order on the categories page" },
    "short_description": { "type": "string", "minLength": 1, "description": "one line: what this slice of the ecosystem covers" },
    "why_it_matters": { "type": "string", "description": "one line: why a builder cares about this category" },
    "defacto": {
      "$ref": "_shared.schema.json#/$defs/framework_ref",
      "description": "the current default choice; absent while nobody has made that judgement for the category"
    },
    "rising": { "type": "array", "items": { "$ref": "_shared.schema.json#/$defs/framework_ref" } },
    "alternatives": { "type": "array", "items": { "$ref": "_shared.schema.json#/$defs/framework_ref" } },
    "key_concepts": { "type": "array", "items": { "type": "string" } },
    "canonical_reading": { "type": "array", "items": { "$ref": "_shared.schema.json#/$defs/reading_item" } },
    "did_you_know": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["label", "short_description"]
}
