{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theaiatlas.dev/schema/frameworks/framework.schema.json",
  "title": "framework",
  "unevaluatedProperties": false,
  "allOf": [
    { "$ref": "_shared.schema.json#/$defs/base" },
    {
      "description": "a curated record carries the hand-written fields; a discovered one holds repository facts only, so none of them is required of it",
      "if": { "properties": { "status": { "const": "curated" } }, "required": ["status"] },
      "then": { "required": ["subcategory", "description", "best_for", "key_features", "use_cases", "pros"] }
    }
  ],
  "properties": {
    "type": { "const": "framework" },
    "schema_version": { "const": 3.0 },
    "status": {
      "type": "string",
      "enum": ["curated", "discovered"],
      "description": "curated: a person wrote the record's prose and judgements; discovered: the discovery step copied it from repository and registry facts and nobody has written it yet"
    },
    "kind": {
      "type": "string",
      "enum": ["framework", "library", "tool"],
      "description": "framework: code you build inside; library: code you call; tool: a program or service you run; absent when nobody has judged it (a record copied from GitHub facts alone)"
    },
    "category": {
      "type": "string",
      "pattern": "^framework-category/[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "FK → framework-category/<slug>"
    },
    "subcategory": { "type": "string", "description": "finer grouping inside the category, as the source names it" },
    "tagline": { "type": "string" },
    "description": { "type": "string", "description": "what the project is, in prose; its only home (the body does not repeat it); required of a curated record" },
    "best_for": { "type": "string" },
    "not_ideal_for": { "type": "string" },
    "key_features": { "type": "array", "items": { "type": "string" } },
    "use_cases": { "type": "array", "items": { "type": "string" } },
    "pros": { "type": "array", "items": { "type": "string" } },
    "cons": { "type": "array", "items": { "type": "string" } },
    "language": { "type": "string", "description": "the main implementation language" },
    "languages_supported": { "type": "array", "items": { "type": "string" } },
    "maintained_by": { "type": "string" },
    "license_spdx": {
      "type": "string",
      "minLength": 1,
      "description": "SPDX identifier, when the project has one single known software licence"
    },
    "license_note": {
      "type": "string",
      "description": "the licence text exactly as the source gives it, when it is compound or proprietary"
    },
    "github_url": { "type": "string", "format": "uri" },
    "docs_url": { "type": "string", "format": "uri" },
    "website_url": { "type": "string", "format": "uri" },
    "maturity": { "type": "string", "enum": ["experimental", "stable", "production"] },
    "backing": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["corporate", "foundation", "community"] },
        "orgs": {
          "type": "array",
          "description": "who backs the project, each entry in one of two shapes: the ID of an organization record (models repository), or the organization's name when it has no record",
          "items": {
            "oneOf": [
              { "type": "string", "pattern": "^organization/[a-z0-9]+(?:-[a-z0-9]+)*$", "description": "FK → organization/<slug>" },
              { "type": "string", "minLength": 1, "not": { "pattern": "^[a-z0-9-]+/[a-z0-9]+(?:-[a-z0-9]+)*$" }, "description": "a name, as the source writes it" }
            ]
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "_shared.schema.json#/$defs/framework_id" },
      "description": "FKs → framework/<slug>; projects that do the same job"
    },
    "ecosystem_connections": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "_shared.schema.json#/$defs/framework_id" },
      "description": "FKs → framework/<slug>; projects this one is commonly used with"
    },
    "registry_signals": {
      "type": "object",
      "description": "numbers that change, copied from the project's registry and repository; owned by the jobs",
      "required": ["observed_at", "source"],
      "additionalProperties": false,
      "properties": {
        "github_stars": { "type": "integer", "minimum": 1 },
        "downloads_monthly": { "type": "integer", "minimum": 1 },
        "latest_version": { "type": "string", "minLength": 1 },
        "latest_release_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "observed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "source": { "type": "string", "format": "uri" }
      }
    }
  },
  "required": ["status", "category"],
  "anyOf": [{ "required": ["license_spdx"] }, { "required": ["license_note"] }]
}
