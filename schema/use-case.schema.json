{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theaiatlas.dev/schema/frameworks/use-case.schema.json",
  "title": "use-case",
  "allOf": [{ "$ref": "_shared.schema.json#/$defs/base" }],
  "properties": {
    "type": { "const": "use-case" },
    "label": { "type": "string", "minLength": 1, "description": "short human label shown in tabs/cards" },
    "order": { "type": "integer", "description": "display order on the getting-started page" },
    "goal": { "type": "string", "minLength": 1, "description": "one-sentence outcome the reader is trying to achieve" },
    "languages": { "type": "array", "items": { "type": "string" }, "description": "programming languages this path uses" },
    "levels": {
      "type": "array",
      "items": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] }
    },
    "stack": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["framework_id", "role", "why"],
        "properties": {
          "framework_id": { "$ref": "_shared.schema.json#/$defs/framework_id" },
          "role": { "type": "string" },
          "why": { "type": "string" },
          "install": { "type": "string" },
          "quickstart_url": { "type": "string", "format": "uri" },
          "docs_url": { "type": "string", "format": "uri" }
        }
      }
    },
    "day1_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "task"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "task": { "type": "string" },
          "estimate": { "type": "string" },
          "details": { "type": "string" }
        }
      }
    },
    "starter_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "repo"],
        "properties": {
          "name": { "type": "string" },
          "repo": { "type": "string", "format": "uri" },
          "why": { "type": "string" }
        }
      }
    },
    "learn_next": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "kind": { "type": "string", "enum": ["video", "course", "paper", "doc", "docs", "blog"] }
        }
      }
    },
    "pitfalls": { "type": "array", "items": { "type": "string" } },
    "when_to_level_up": { "type": "string" },
    "community": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "dont_use": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["what", "why"],
        "properties": {
          "what": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    },
    "related_use_cases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of related use-case files (use-case/<slug>); the site reader strips the prefix"
    }
  },
  "required": ["label", "goal", "languages", "levels", "stack", "day1_plan"]
}
